{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start:prod": "NODE_ENV=production bun ./dist/server.js",
    "start:dev": "NODE_ENV=development bun --watch src/server.ts",
    "check:types": "tsc --noEmit",
    "build": "bunx --bun prisma generate && tsc",
    "prod:build": "bun install && bunx --bun prisma migrate deploy && bunx --bun prisma generate && tsc",
    "gm": "ts-node gn-module.ts",
    "pgen:studio": "bunx --bun prisma generate && bunx --bun prisma studio --port 7548",
    "pm": "bunx --bun prisma migrate dev",
    "pgen": "bunx --bun prisma generate",
    "pm:pgen": "bun run pm && bun run pgen",
    "pm:co": "bunx --bun prisma migrate dev --create-only",
    "pm:deploy": "bunx --bun prisma migrate deploy",
    "studio": "bunx --bun prisma studio --port 7548",
    "postinstall": "bunx --bun prisma generate",
    "dbpush": "bunx --bun prisma db push",
    "pm:reset": "bunx --bun prisma migrate reset",
    "docker:up": "docker compose --profile local up -d",
    "docker:down": "docker compose --profile local down",
    "lint:check": "eslint --ignore-path .eslintignore --ext .js,.ts .",
    "lint:fix": "eslint . --fix",
    "prettier:check": "prettier --ignore-path .gitignore --write \"**/*.+(js|ts|json)\"",
    "prettier:fix": "prettier --write .",
    "lint-prettier": "yarn lint:check && yarn prettier:check",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^7.0.4",
    "@types/pg": "^8.20.0",
    "eslint": "^9.39.1",
    "prettier": "^3.8.1",
    "prisma": "^7.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.936.0",
    "@aws-sdk/lib-storage": "^3.936.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.9.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.2",
    "firebase-admin": "^14.3.0",
    "http-status": "^2.1.0",
    "jsonwebtoken": "^9.0.2",
    "minio": "^8.0.6",
    "multer": "^2.1.0",
    "nanoid": "^5.1.6",
    "nodemailer": "^8.0.1",
    "pg": "^8.22.0",
    "ts-node-dev": "^2.0.0",
    "zod": "^4.3.6"
  }
}
